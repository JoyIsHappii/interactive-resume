<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Exact Pixel Avatar</title>

  <style>
    html, body {
      margin: 0;
      min-height: 100%;
      background: transparent;
    }

    .pixel-avatar {
      width: 500px;
      height: 500px;
      display: block;
      object-fit: contain;

      /* Keeps the original hard pixel edges when scaled */
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }
  </style>
</head>

<body>
  <!-- Exact attached avatar — transparent background -->
  <img
    class="pixel-avatar"
    src="data:image/png;base64,"
    alt="Pixel art avatar"
  />
</body>
</html>
